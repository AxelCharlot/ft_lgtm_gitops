{
  "uid": "lgtm-traces",
  "title": "traces",
  "tags": ["lgtm"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run duration, p95 — click a diamond to open its trace",
      "description": "One bucket keeps one exemplar per 15 s export, so the diamonds are a sample of the runs and never a list of them.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lgtm_execution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mean run duration",
      "description": "The histogram sum divided by its count, over the window on screen.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "none", "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(lgtm_execution_duration_seconds_sum[$__range])) / sum(increase(lgtm_execution_duration_seconds_count[$__range]))",
          "instant": true,
          "legendFormat": "mean"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Longest run",
      "description": "The largest value the last-run gauge held over the window on screen.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value", "colorMode": "value", "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(max_over_time(lgtm_execution_duration_last_seconds[$__range]))",
          "instant": true,
          "legendFormat": "longest"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Slow or broken — click a row to open its trace",
      "description": "Every run over three seconds and every run that failed.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{name=\"POST /api/run\" && (duration > 3s || status = error)}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "cellHeight": "sm", "showHeader": true }
    }
  ]
}